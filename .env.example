# Browser-visible settings for the dedicated AlkanePuzzleCompetition project only.
VITE_SUPABASE_URL=https://fethojoncgermqwzrwtw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<new-project-publishable-key>

# Edge secrets are configured in Supabase, never in VITE_* or committed files:
# COMPETITION_DATABASE_URL  = this project's Connect > Transaction pooler URI
# MASTER_TEACHER_EMAIL      = same master email configured in IonicFormulaCompetition
# ALLOWED_ORIGINS           = exact published origin(s), comma-separated
# SHARED_TEACHER_AUTHORITY_URL = IonicFormulaCompetition competition/shared-teacher URL
# SHARED_TEACHER_HMAC_SECRET   = private per-app HMAC key shared with central Edge secret

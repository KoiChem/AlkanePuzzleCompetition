    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.25.12",
    "miniflare": "5.20261006.0-alpha",
    "typescript": "5.9.3",
    "vite": "8.0.13",

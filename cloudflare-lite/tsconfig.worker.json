{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "worker/**/*.ts",
    "game/**/*.ts",
    "src/protocol.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "game/client/**/*"
  ]
}

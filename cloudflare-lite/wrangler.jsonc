{
  "name": "alkanecompetition",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-07",
  "account_id": "57b6032a34645abf597e8662b0e70ede",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "RELEASE_SHA": "development",
    "APP_ORIGIN": "https://alkanecompetition.koichem.workers.dev",
    "MASTER_TEACHER_EMAIL": "taiyaki.taiyaki.taiyaki@gmail.com",
    "GOOGLE_CLIENT_ID": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "AlkaneRoom"
      },
      {
        "name": "TEACHERS",
        "class_name": "AlkaneTeachers"
      }
    ]
  },
  "migrations": [
    {
      "tag": "alkane-v1",
      "new_sqlite_classes": [
        "AlkaneRoom",
        "AlkaneTeachers"
      ]
    }
  ]
}
